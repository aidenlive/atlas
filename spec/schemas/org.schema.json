{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/spec/schemas/org.schema.json",
  "title": "Atlas organization manifest",
  "description": "The organization above the repositories: stewards, teams, and policy defaults (ADMIN, org profile).",
  "type": "object",
  "required": ["standard", "org", "stewards", "teams"],
  "additionalProperties": false,
  "properties": {
    "standard": {"type": "string", "pattern": "^project/[0-9]+\\.[0-9]+$"},
    "org": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "stewards": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "description": "R-4: at least two for bus factor, at most five for accountability",
      "items": {"type": "string", "pattern": "^person:[a-z0-9-]+$"}
    },
    "teams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "lead"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^team:[a-z0-9-]+$"},
          "name": {"type": "string"},
          "lead": {"type": "string", "pattern": "^person:[a-z0-9-]+$"},
          "members": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_role": {"type": "string", "enum": ["observer", "contributor"], "description": "R-1"},
        "access_review_days": {"type": "integer", "minimum": 30, "maximum": 365},
        "agent_max_role": {"type": "string", "enum": ["contributor", "maintainer"], "description": "R-3"},
        "required_visibility": {"type": "string", "enum": ["public", "internal", "restricted", "private"]}
      }
    }
  }
}
