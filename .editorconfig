# Mechanics the standard requires, applied by the editor rather than by review
# (WRITING WR-09, PROJECT PJ-16).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break; do not strip them.
trim_trailing_whitespace = false
